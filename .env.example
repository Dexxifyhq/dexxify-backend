# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ── Database (Postgres — works with any provider) ─
DATABASE_URL=postgresql://user:password@host:5432/dexxify
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-db-password
DB_DATABASE=dexxify

# ── JWT ──────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRATION=1800s
JWT_REFRESH_SECRET=your-refresh-secret
JWT_REFRESH_EXPIRATION=1d

# ── Breet (Crypto Provider) ─────────────────────
BREET_API_URL=https://api.breet.com/v1
BREET_API_KEY=your-breet-api-key
BREET_SECRET_KEY=your-breet-secret-key
BREET_WEBHOOK_SECRET=your-breet-webhook-secret

# ── Kora (KYC/AML) ─────────────────────────────
KORA_SECRET_KEY=your-kora-secret-key
KORA_PUBLIC_KEY=your-kora-public-key
KORA_TEST_SECRET_KEY=your-kora-test-secret-key
KORA_TEST_PUBLIC_KEY=your-kora-test-public-key
KORA_ENCRYPTION_KEY=your-kora-encryption-key
KORA_TEST_ENCRYPTION_KEY=your-kora-test-encryption-key

# ── Redis ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Webhook ─────────────────────────────────────
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=5000

# ── Rate Limiting ───────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Frontend ────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── SMTP (Email) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Dexxify
SMTP_FROM_EMAIL=noreply@dexxify.com

# ── OTP ─────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60